# ---- Set these in Vercel: Project -> Settings -> Environment Variables (never commit real values) ----
# Supabase (Project Settings -> API). The anon key is designed to be public; Row Level Security protects data.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# NOTE: the backend does NOT use a service-role key. Do not add one.

# Weather. The free Open-Meteo endpoint is NON-COMMERCIAL ONLY.
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
WEATHER_API_KEY=

# Plant Doctor model service (see ml/README.md). Leave empty until a model is trained, evaluated and deployed.
AI_MODEL_ENDPOINT=
AI_MODEL_TOKEN=

# Optional AI assistant. Pick ONE provider and set only its key; leave both empty to keep it off.
ASSISTANT_PROVIDER=anthropic
ANTHROPIC_API_KEY=
GROQ_API_KEY=
ASSISTANT_MODEL=

# Historical rainfall (Open-Meteo archive).
ARCHIVE_API_URL=https://archive-api.open-meteo.com/v1/archive

# ---- Alerts outside the app (all optional) ----
# Web push is FREE. Generate keys once with:  python scripts/generate_vapid.py
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Long random string. Same value in Vercel and in the cron_secrets row.
CRON_SECRET=
CRON_MAX_FARMS=200
# WhatsApp Business Cloud API: NOT free for business-started messages. Leave blank to keep it off.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en
